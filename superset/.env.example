# ── Superset Core ──────────────────────────────────────
SUPERSET_SECRET_KEY=your_strong_random_secret_key_here
SUPERSET_ENV=production

# ── Metadata DB (Postgres) ────────────────────────────
SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://superset:superset@superset-db:5432/superset

# ── Cache (Redis) ──────────────────────────────────────
REDIS_HOST=superset-cache
REDIS_PORT=6379

# ── Celery ─────────────────────────────────────────────
CELERY_BROKER_URL=redis://superset-cache:6379/0
CELERY_RESULT_BACKEND=redis://superset-cache:6379/1

# ── DuckDB data path (mounted read-only) ──────────────
DUCKDB_PATH=/data/florida_parcels.duckdb

# ── Superset Feature Flags ─────────────────────────────
SUPERSET_LOAD_EXAMPLES=false
